# ============================================================
# VizagIVF HRMS — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Supabase (Required) ────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Google Maps (Required for Address Search) ──────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (New) + Geocoding API
# Free tier: $200/month credit (~11,700 searches/month free)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─── Map Display Settings ───────────────────────────────────
# Default center coordinates — set to your client's operating city
VITE_MAP_DEFAULT_LAT=17.6868
VITE_MAP_DEFAULT_LNG=83.2185
VITE_MAP_DEFAULT_ZOOM=13

# ─── Field Operations ───────────────────────────────────────
# OSRM routing (public demo — self-host before production load)
VITE_OSRM_ENDPOINT=https://router.project-osrm.org
# Location broadcast interval in ms (default 10s)
VITE_LIVE_BROADCAST_INTERVAL_MS=10000

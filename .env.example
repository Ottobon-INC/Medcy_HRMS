# ========================================================
# VizagIVF HRMS — Environment Configuration
# ========================================================

# Supabase Credentials (Required)
# Retrieve these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Server Port Configuration
PORT=9640

# ========================================================
# Field Operations & Live Tracking Configuration
# ========================================================

# Feature Gate (Defaults to false/OFF for existing client safety)
VITE_FEATURE_LIVE_TRACKING=false

# Map Tile Provider (OpenStreetMap clean tiles - no watermark, no API key needed)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Default Map Center and Zoom level (Configurable per client deployment region)
VITE_MAP_DEFAULT_LAT=17.6868
VITE_MAP_DEFAULT_LNG=83.2185
VITE_MAP_DEFAULT_ZOOM=13

# OSRM Routing Endpoint (Public demo is PoC only. Self-host before production traffic)
VITE_OSRM_ENDPOINT=https://router.project-osrm.org

# Realtime broadcast cadence (in milliseconds, default: 10000 = 10s)
VITE_LIVE_BROADCAST_INTERVAL_MS=10000
